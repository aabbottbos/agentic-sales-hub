{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deal-desk.dev/schema/skill-def.json",
  "title": "Skill definition",
  "description": "The data shape that drives a Claude Code skill, the MCP tool, and the eval runner from one file (spec §5.3).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "tier": { "enum": ["retrieval", "generation", "review"] },
    "version": { "type": "integer", "minimum": 1 },
    "context_grants": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^context/" }
        },
        "write": {
          "type": "array",
          "items": { "type": "string", "pattern": "^context/" }
        }
      },
      "required": ["read"],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "enum": ["string", "number", "boolean"] },
          "required": { "type": "boolean" },
          "enum": { "type": "array", "items": { "type": "string" } },
          "default": {}
        },
        "required": ["type"],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "requires_citations": { "type": "boolean" }
      },
      "required": ["schema", "requires_citations"],
      "additionalProperties": false
    },
    "eval_suite": { "type": "string", "pattern": "^evals/cases/" },
    "tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string", "minLength": 1 }
  },
  "required": [
    "id",
    "tier",
    "version",
    "context_grants",
    "inputs",
    "output",
    "eval_suite",
    "tools"
  ],
  "additionalProperties": false
}
