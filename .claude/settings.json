{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(./context/accounts/**/inbound/**)",
      "Read(./examples/demo-corpus/accounts/**/inbound/**)",
      "Write(./context/legal/**)",
      "Edit(./context/legal/**)",
      "Write(./examples/demo-corpus/legal/**)",
      "Edit(./examples/demo-corpus/legal/**)",
      "Write(./evals/golden/**)",
      "Edit(./evals/golden/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/quarantine-inbound.sh" },
          { "type": "command", "command": ".claude/hooks/protect-paths.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": ".claude/hooks/format-on-write.sh" }]
      }
    ]
  }
}
