{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sales-hub.dev/schema/pricing.json",
  "title": "Org — pricing",
  "type": "object",
  "allOf": [{ "$ref": "frontmatter-common.json#/$defs/commonFields" }],
  "properties": {
    "fictional": true,
    "mutability": { "const": "canonical" },
    "schema_version": true,
    "created": true,
    "title": true,
    "rate_card": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "rate": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "enum": ["hour", "day", "week", "month"] }
        },
        "required": ["role", "rate", "unit"],
        "additionalProperties": false
      }
    },
    "discount_authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "approver": { "type": "string", "minLength": 1 },
          "max_pct": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["approver", "max_pct"],
        "additionalProperties": false
      }
    },
    "floor_pct": { "type": "number", "minimum": 0, "maximum": 100 }
  },
  "required": ["rate_card", "discount_authority", "floor_pct"],
  "unevaluatedProperties": false
}
