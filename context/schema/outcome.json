{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sales-hub.dev/schema/outcome.json",
  "title": "Outcome record",
  "description": "One JSON object per line of outcomes.jsonl. Append-only. NOT a frontmatter file — does not compose frontmatter-common.",
  "type": "object",
  "properties": {
    "date": { "type": "string", "format": "date" },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path of the artifact this outcome concerns."
    },
    "outcome": {
      "enum": [
        "sent",
        "won",
        "lost",
        "redline_accepted",
        "redline_rejected",
        "superseded",
        "unused"
      ]
    },
    "note": { "type": "string" }
  },
  "required": ["date", "artifact", "outcome"],
  "additionalProperties": false
}
