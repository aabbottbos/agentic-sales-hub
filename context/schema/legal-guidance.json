{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sales-hub.dev/schema/legal-guidance.json",
  "title": "Legal — guidance",
  "type": "object",
  "allOf": [{ "$ref": "frontmatter-common.json#/$defs/commonFields" }],
  "properties": {
    "fictional": true,
    "mutability": { "const": "canonical" },
    "schema_version": true,
    "created": true,
    "title": true,
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "red_line": { "type": "string", "minLength": 1 },
          "fallback_ladder": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["topic", "red_line", "fallback_ladder"],
        "additionalProperties": false
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 }
  },
  "required": ["positions", "disclaimer"],
  "unevaluatedProperties": false
}
