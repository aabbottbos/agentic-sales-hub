{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deal-desk.dev/schema/clause.json",
  "title": "Legal — clause-library entry",
  "type": "object",
  "allOf": [{ "$ref": "frontmatter-common.json#/$defs/commonFields" }],
  "properties": {
    "fictional": true,
    "mutability": { "const": "canonical" },
    "schema_version": true,
    "created": true,
    "title": true,
    "clause_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable id findings cite by. Must equal the file basename."
    },
    "topic": { "type": "string", "minLength": 1 },
    "position": {
      "enum": ["preferred", "acceptable", "unacceptable"],
      "description": "Meridian's standing posture on this clause as written in our paper."
    },
    "rationale": { "type": "string", "minLength": 1 },
    "standard_language": {
      "type": "string",
      "minLength": 1,
      "description": "Our preferred wording. Used as suggested_redline when a finding fires."
    },
    "unacceptable_patterns": {
      "type": "array",
      "minItems": 1,
      "description": "Regex strings the deterministic sow-review matcher scans an inbound doc for.",
      "items": { "type": "string", "minLength": 1 }
    },
    "pattern_severity": {
      "type": "object",
      "description": "Map from a pattern in unacceptable_patterns to the severity a match should carry.",
      "additionalProperties": { "enum": ["blocker", "major", "minor"] },
      "minProperties": 1
    }
  },
  "required": [
    "clause_id",
    "topic",
    "position",
    "rationale",
    "standard_language",
    "unacceptable_patterns",
    "pattern_severity"
  ],
  "unevaluatedProperties": false
}
