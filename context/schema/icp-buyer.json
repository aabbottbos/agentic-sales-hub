{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sales-hub.dev/schema/icp-buyer.json",
  "title": "Demand-gen — ICP buyer",
  "type": "object",
  "allOf": [{ "$ref": "frontmatter-common.json#/$defs/commonFields" }],
  "properties": {
    "fictional": true,
    "mutability": { "const": "canonical" },
    "schema_version": true,
    "created": true,
    "title": true,
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role_title": { "type": "string", "minLength": 1 },
          "priorities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "objections": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["role_title", "priorities", "objections"],
        "additionalProperties": false
      }
    }
  },
  "required": ["roles"],
  "unevaluatedProperties": false
}
